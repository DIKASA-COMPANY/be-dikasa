        <mxCell id="e4" value="scoped catalog FKs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;" edge="1" parent="1" source="refs" target="lines">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="atomic" value="&lt;b&gt;Checkout transaction&lt;/b&gt;&lt;br&gt;Lock draft, verify open/revision/cart&lt;br&gt;Validate catalog; lock products in stable order&lt;br&gt;Insert receipt/items; deduct stock&lt;br&gt;Mark paid, link receipt, increment revision&lt;br&gt;Failure rolls back everything; draft keeps audit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="460" width="360" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram name="Refund ledger — 2026-10-24" id="refunds-2026-10-24"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1300"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="receipt" parent="1" vertex="1" value="TRANSACTIONS / TRANSACTION_ITEMS (existing)&#10;&#10;transactions.refund_revision BIGINT NOT NULL DEFAULT 0 CHECK &gt;=0&#10;status: paid | partially_refunded | refunded | cancelled&#10;transactions UNIQUE(id,outlet_id) retained&#10;transaction_items UNIQUE(id,transaction_id,outlet_id) added&#10;Original receipt prices, discounts, taxes and item quantities retained" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="30" y="30" width="680" height="190" /></mxCell><mxCell id="refund" parent="1" vertex="1" value="TRANSACTION_REFUNDS&#10;&#10;id UUID PK; number VARCHAR(50) NOT NULL UNIQUE&#10;outlet_id UUID NOT NULL FK outlets(id)&#10;transaction_id UUID NOT NULL; actor_id UUID NOT NULL FK users(id)&#10;actor_name TEXT NOT NULL (immutable snapshot)&#10;cash_session_id UUID NOT NULL (current session)&#10;reason VARCHAR(500) NOT NULL, trimmed nonempty&#10;method VARCHAR(20): cash | wallet | debit_card | qris | transfer&#10;mode VARCHAR(10): full | items&#10;net_amount, tax_amount BIGINT NOT NULL CHECK &gt;=0&#10;total_amount BIGINT NOT NULL CHECK 0..9007199254740991&#10;CHECK total_amount=net_amount+tax_amount&#10;created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()&#10;request_id UUID NOT NULL; payload_hash CHAR(64) NOT NULL&#10;response JSONB NOT NULL DEFAULT '{}' (immutable success)&#10;UNIQUE(outlet_id,request_id); UNIQUE(id,transaction_id,outlet_id)&#10;FK(transaction_id,outlet_id) -&gt; transactions(id,outlet_id)&#10;FK(cash_session_id,outlet_id) -&gt; cash_sessions(id,outlet_id)&#10;INDEX(outlet_id,transaction_id,created_at DESC,id)&#10;INDEX(outlet_id,created_at DESC,id)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="30" y="290" width="680" height="520" /></mxCell><mxCell id="line" parent="1" vertex="1" value="TRANSACTION_REFUND_ITEMS&#10;&#10;id UUID PK; refund_id,transaction_id,outlet_id UUID NOT NULL&#10;transaction_item_id UUID NOT NULL&#10;quantity INTEGER NOT NULL CHECK 1..1000&#10;restock_quantity INTEGER NOT NULL CHECK 0..quantity&#10;net_amount, tax_amount BIGINT NOT NULL CHECK &gt;=0&#10;total_amount BIGINT NOT NULL CHECK 0..9007199254740991&#10;CHECK total_amount=net_amount+tax_amount&#10;UNIQUE(refund_id,transaction_item_id)&#10;FK(refund_id,transaction_id,outlet_id) -&gt; transaction_refunds triple&#10;FK(transaction_item_id,transaction_id,outlet_id) -&gt; transaction_items triple&#10;INDEX(outlet_id,transaction_id,transaction_item_id)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="820" y="290" width="680" height="370" /></mxCell><mxCell id="stock" parent="1" vertex="1" value="STOCK_MOVEMENTS (existing, extended)&#10;&#10;refund_id UUID NULL&#10;kind: configure | adjust | sale | refund_return&#10;CHECK (kind='refund_return')=(refund_id IS NOT NULL)&#10;FK(refund_id,transaction_id,outlet_id) -&gt; transaction_refunds triple&#10;Existing product/actor/outlet/receipt fields retained&#10;Return budget uses original sale deduction; zero stock return by default" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="820" y="750" width="680" height="220" /></mxCell><mxCell id="a" parent="1" edge="1" source="receipt" target="refund" value="receipt 1 -&gt; 0..N refunds" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b" parent="1" edge="1" source="refund" target="line" value="refund 1 -&gt; 1..N allocations" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c" parent="1" edge="1" source="receipt" target="line" value="original item 1 -&gt; 0..N allocations" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d" parent="1" edge="1" source="refund" target="stock" value="refund 1 -&gt; 0..N stock returns" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram>
<diagram name="Cash reconciliation — 2026-10-24" id="cash-closing-2026-10-24"><mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="session" parent="1" vertex="1" value="CASH_SESSIONS — additive migration000012&#10;&#10;Existing id/outlet_id/user_id, opening_cash, closing_cash, status, times retained&#10;closed_by UUID NULL FK users(id); closed_by_name TEXT NULL&#10;closing_reason VARCHAR(500) NULL&#10;expected_cash BIGINT NULL CHECK +/-9007199254740991&#10;cash_difference BIGINT NULL CHECK +/-9007199254740991&#10;close_request_id UUID NULL; close_payload_hash CHAR(64) NULL&#10;close_preview_hash CHAR(64) NULL; closing_summary JSONB NULL&#10;New closure metadata: all NULL (legacy) OR all NOT NULL and status=closed&#10;CHECK closing_cash::numeric - expected_cash::numeric = cash_difference&#10;CHECK cash_difference=0 OR trimmed closing_reason is nonempty&#10;UNIQUE INDEX(outlet_id,close_request_id) WHERE close_request_id IS NOT NULL&#10;Existing one-open-session-per-outlet unique partial index preserved&#10;JSON freezes original session totals and immutable close response" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="30" y="30" width="790" height="400" /></mxCell><mxCell id="users" parent="1" vertex="1" value="USERS (existing)&#10;&#10;id UUID PK&#10;Opening actor: cash_sessions.user_id&#10;Closing actor: cash_sessions.closed_by NULL&#10;Role/active/outlet enforce permission in service" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="950" y="30" width="390" height="165" /></mxCell><mxCell id="sales" parent="1" vertex="1" value="TRANSACTIONS (existing)&#10;&#10;cash_session_id UUID NOT NULL FK cash_sessions&#10;Original cash inflow = paid_amount - change_amount&#10;Retain inflow after partial/full refunds&#10;Creation holds session FOR SHARE through commit" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="30" y="600" width="610" height="190" /></mxCell><mxCell id="refund" parent="1" vertex="1" value="TRANSACTION_REFUNDS (existing)&#10;&#10;cash_session_id UUID NOT NULL, scoped FK session/outlet&#10;Cash outflow determined by OWN method=cash&#10;Original sale may belong to an older closed session&#10;Confirmation holds session FOR SHARE; replay first" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="730" y="600" width="610" height="190" /></mxCell><mxCell id="a" parent="1" edge="1" source="session" target="users" value="opening 1 / closing 0..1 actor" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b" parent="1" edge="1" source="session" target="sales" value="session 1 -&gt; 0..N sales" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c" parent="1" edge="1" source="session" target="refund" value="paying session 1 -&gt; 0..N refunds" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram>
<diagram name="Original category reporting — 2026-10-24" id="sales-reports-2026-10-24"><mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="items" parent="1" vertex="1" value="TRANSACTION_ITEMS — migration000013&#10;&#10;Existing id,transaction_id,outlet_id,product_id,product_variant_id retained&#10;Existing original name/price/quantity/line_total snapshots retained&#10;category_id_snapshot UUID NULL&#10;category_name_snapshot TEXT NULL&#10;CHECK both NULL OR both NOT NULL and trimmed name nonempty&#10;No FK to mutable catalog category; historical identity is evidence&#10;Old rows stay NULL (no guessed category backfill)&#10;New checkout records validated server category while category FOR SHARE held&#10;Down refuses to erase populated snapshot evidence" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="30" y="30" width="800" height="330" /></mxCell><mxCell id="catalog" parent="1" vertex="1" value="PRODUCT_CATEGORIES / PRODUCTS (existing)&#10;&#10;Current category identity/name may change&#10;Checkout product locks precede category shared locks&#10;Report queries never substitute current category/price/cost&#10;No new cost snapshot/profit claim introduced" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="900" y="30" width="430" height="210" /></mxCell><mxCell id="sales" parent="1" vertex="1" value="TRANSACTIONS (existing)&#10;&#10;paid_at assigns original sale date&#10;Original charged subtotal/discount/tax/total&#10;Original sale retained after later refunds&#10;Legacy unverifiable status produces exclusion notice" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="30" y="500" width="600" height="200" /></mxCell><mxCell id="refund" parent="1" vertex="1" value="TRANSACTION_REFUNDS / ITEMS (existing)&#10;&#10;created_at assigns actual return date&#10;Original item ID resolves product/variant/category evidence&#10;Recorded net/tax/quantity used exactly once&#10;Refund method is independent of original payment method" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry as="geometry" x="730" y="500" width="600" height="200" /></mxCell><mxCell id="a" parent="1" edge="1" source="catalog" target="items" value="copy original category at checkout (not FK)" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b" parent="1" edge="1" source="sales" target="items" value="original receipt 1 -&gt; N lines" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c" parent="1" edge="1" source="refund" target="items" value="refund allocations -&gt; original item IDs" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram>
<diagram name="Cash movements (000015)" id="cash-movements-000015"><mxGraphModel grid="1" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="cash-ledger-table" value="CASH_MOVEMENTS&#10;PK id uuid&#10;outlet_id uuid NOT NULL&#10;cash_session_id uuid NOT NULL&#10;created_by uuid NOT NULL FK users&#10;created_by_name varchar(201) NOT NULL (snapshot)&#10;created_at timestamptz NOT NULL&#10;request_id uuid NOT NULL&#10;payload_hash char(64) NOT NULL&#10;kind varchar(3): in | out&#10;amount bigint: 1..9007199254740991&#10;name varchar(120), trimmed nonempty&#10;reason varchar(500), trimmed nonempty&#10;reverses_id uuid NULL UNIQUE (self FK)&#10;proof_object_key text NULL&#10;proof_content_type varchar(10) NULL (PNG/JPEG)&#10;proof_sha256 char(64) NULL&#10;proof_size bigint NULL (1..3145728)&#10;UNIQUE(outlet_id, request_id)&#10;UNIQUE(id, cash_session_id, outlet_id)&#10;Proof metadata: all NULL or all present&#10;CHECK reverses_id != id&#10;Index(outlet_id,cash_session_id,created_at,id)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="30" width="450" height="690" as="geometry" /></mxCell><mxCell id="cash-ledger-session" value="CASH_SESSIONS (existing)&#10;PK id uuid&#10;outlet_id uuid&#10;UNIQUE(id,outlet_id)&#10;One open session per outlet" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="290" height="150" as="geometry" /></mxCell><mxCell id="cash-ledger-user" value="USERS (existing)&#10;PK id uuid&#10;role_id, outlet_id&#10;Account activity/role checked on write" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="290" height="130" as="geometry" /></mxCell><mxCell id="cash-ledger-session-fk" edge="1" parent="1" source="cash-ledger-session" target="cash-ledger-table" value="1 : N (session,outlet); RESTRICT delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=ERmany;startArrow=ERone;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cash-ledger-actor-fk" edge="1" parent="1" source="cash-ledger-user" target="cash-ledger-table" value="1 : N actor; RESTRICT delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=ERmany;startArrow=ERone;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cash-ledger-reversal-fk" edge="1" parent="1" source="cash-ledger-table" target="cash-ledger-table" value="0..1 opposite entry (id,session,outlet)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=ERmany;startArrow=ERone;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram name="Firebase URL-only media (000016)" id="firebase-url-only-000016"><mxGraphModel grid="1" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="products-url" value="PRODUCTS&#10;&#10;image_url TEXT NULL&#10;Firebase download URL only&#10;image_object_name removed" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="150" as="geometry" /></mxCell><mxCell id="users-url" value="USERS&#10;&#10;avatar_url TEXT NULL&#10;Firebase download URL only&#10;avatar_object_name removed" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="300" height="150" as="geometry" /></mxCell><mxCell id="cash-url" value="CASH_MOVEMENTS&#10;&#10;proof_url TEXT NULL&#10;Firebase download URL only&#10;proof object key, MIME, hash and size columns removed" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="300" height="180" as="geometry" /></mxCell><mxCell id="postgres-note" value="PostgreSQL remains the primary database.&#10;Firebase is limited to Authentication and image object storage.&#10;All image APIs persist one URL using the shared uploader." style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="340" width="680" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram>

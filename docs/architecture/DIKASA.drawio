  <diagram name="Shared product stock (migration 000009)" id="stock-000009">
    <mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="stock-root" />
        <mxCell id="stock-layer" parent="stock-root" />
        <mxCell id="stock-products" value="&lt;b&gt;PRODUCTS — added columns&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id UUID&lt;br&gt;FK outlet_id UUID&lt;br&gt;UQ (id, outlet_id)&lt;br&gt;track_stock BOOLEAN NOT NULL DEFAULT FALSE&lt;br&gt;stock_quantity BIGINT NOT NULL DEFAULT 0&lt;br&gt;low_stock_threshold BIGINT NOT NULL DEFAULT 0&lt;br&gt;CHECK quantities BETWEEN 0 AND 1000000000&lt;br&gt;&lt;br&gt;Base and all variations share this one balance.&lt;br&gt;Normal product PATCH never writes these columns." vertex="1" parent="stock-layer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="80" y="100" width="430" height="340" as="geometry" />
        </mxCell>
        <mxCell id="stock-movements" value="&lt;b&gt;STOCK_MOVEMENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id UUID&lt;br&gt;FK outlet_id → outlets.id&lt;br&gt;FK (product_id,outlet_id) → products(id,outlet_id)&lt;br&gt;FK? transaction_id → transactions.id&lt;br&gt;FK created_by → users.id&lt;br&gt;request_id UUID NULL&lt;br&gt;UQ (outlet_id,request_id)&lt;br&gt;payload_hash VARCHAR(64) NOT NULL&lt;br&gt;kind configure | adjust | sale&lt;br&gt;quantity_delta BIGINT NOT NULL&lt;br&gt;balance_after BIGINT NOT NULL CHECK &amp;gt;= 0&lt;br&gt;track_stock BOOLEAN NOT NULL&lt;br&gt;low_stock_threshold BIGINT NOT NULL&lt;br&gt;reason TEXT NOT NULL&lt;br&gt;created_at TIMESTAMPTZ NOT NULL&lt;br&gt;IDX (outlet_id,product_id,created_at DESC)" vertex="1" parent="stock-layer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="650" y="80" width="480" height="580" as="geometry" />
        </mxCell>
        <mxCell id="stock-transactions" value="&lt;b&gt;TRANSACTIONS&lt;/b&gt;&lt;br&gt;PK id UUID&lt;br&gt;FK outlet_id&lt;br&gt;Receipt, items and stock deductions commit together." vertex="1" parent="stock-layer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="80" y="520" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stock-users" value="&lt;b&gt;USERS / OUTLETS&lt;/b&gt;&lt;br&gt;users.id identifies the actor.&lt;br&gt;outlets.id scopes balances and request deduplication." vertex="1" parent="stock-layer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="650" y="740" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stock-edge-product" edge="1" parent="stock-layer" source="stock-products" target="stock-movements" value="1 : N (same outlet)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stock-edge-sale" edge="1" parent="stock-layer" source="stock-transactions" target="stock-movements" value="1 : N optional transaction reference" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stock-edge-user" edge="1" parent="stock-layer" source="stock-users" target="stock-movements" value="actor and outlet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Saved orders - migration 000010" id="saved-orders-000010">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="draft" value="&lt;b&gt;saved_orders&lt;/b&gt;&lt;br&gt;id UUID PK; UNIQUE(id,outlet_id)&lt;br&gt;outlet_id FK outlets; created_by FK users&lt;br&gt;label VARCHAR(100) NOT NULL&lt;br&gt;order_type_id + outlet_id composite FK&lt;br&gt;revision BIGINT &gt;0; status open/paid/deleted&lt;br&gt;transaction_id UUID nullable UNIQUE FK transactions&lt;br&gt;CHECK paid iff transaction_id IS NOT NULL&lt;br&gt;created_at,updated_at TIMESTAMPTZ NOT NULL&lt;br&gt;INDEX outlet_id,status,updated_at DESC,id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="40" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lines" value="&lt;b&gt;saved_order_items&lt;/b&gt;&lt;br&gt;id UUID PK&lt;br&gt;saved_order_id + outlet_id composite FK&lt;br&gt;product_id + outlet_id composite FK products&lt;br&gt;product_variant_id nullable; composite FK&lt;br&gt;(variant_id,product_id,outlet_id) to variants&lt;br&gt;position INTEGER &gt;=0; UNIQUE(order,position)&lt;br&gt;product_name VARCHAR(150) NOT NULL&lt;br&gt;variant_name VARCHAR(100) nullable&lt;br&gt;unit_price BIGINT 0..9007199254740991&lt;br&gt;quantity INTEGER 1..1000; notes VARCHAR(500)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="40" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="commands" value="&lt;b&gt;saved_order_commands&lt;/b&gt;&lt;br&gt;PK(outlet_id,request_id) UUID&lt;br&gt;outlet_id FK outlets; actor_id FK users&lt;br&gt;operation create/update/delete&lt;br&gt;payload_hash CHAR(64) NOT NULL&lt;br&gt;saved_order_id + outlet_id composite FK&lt;br&gt;response JSONB NOT NULL, immutable snapshot&lt;br&gt;Advisory lock outlet/request then draft row lock" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="460" width="360" height="230" as="geometry" />
        </mxCell>
        <mxCell id="refs" value="&lt;b&gt;Existing reference tables&lt;/b&gt;&lt;br&gt;outlets(id), users(id)&lt;br&gt;order_types UNIQUE(id,outlet_id)&lt;br&gt;products UNIQUE(id,outlet_id)&lt;br&gt;product_variants UNIQUE(id,product_id,outlet_id)&lt;br&gt;transactions(id) receipt&lt;br&gt;Service enforces account outlet, role and catalog ownership" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 → 0..100 lines" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;" edge="1" parent="1" source="draft" target="lines">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="1 → many successful commands" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;" edge="1" parent="1" source="draft" target="commands">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="outlet,actor,type,receipt FKs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;" edge="1" parent="1" source="refs" target="draft">
          <mxGeometry relative="1" as="geometry" />

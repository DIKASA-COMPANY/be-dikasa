PORT=8081
AUTH_MODE=local
DATABASE_URL=postgres://dikasa:replace-with-your-local-password@localhost:5432/dikasa?sslmode=disable
# Generate a random value with: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
LOCAL_AUTH_SECRET=
MAIL_MODE=disabled
IMAGE_STORAGE_MODE=disabled
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional persistent product photos, without Firebase:
# IMAGE_STORAGE_MODE=local
# LOCAL_IMAGE_DIRECTORY=uploads
# PUBLIC_BASE_URL=http://127.0.0.1:8081

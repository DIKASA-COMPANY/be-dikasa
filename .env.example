PORT=8080
AUTH_MODE=firebase
# Local development: AUTH_MODE=local, MAIL_MODE=disabled and a random >=32-byte secret.
LOCAL_AUTH_SECRET=
MAIL_MODE=smtp
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgres://dikasa:password@localhost:5432/dikasa?sslmode=disable
FIREBASE_PROJECT_ID=dummy-project
FIREBASE_WEB_API_KEY=dummy-key
IMAGE_STORAGE_MODE=disabled
FIREBASE_STORAGE_BUCKET=dummy-project.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
OTP_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Dikasa <mailer@example.com>

# Optional persistent product photos, without Firebase:
# IMAGE_STORAGE_MODE=local
# LOCAL_IMAGE_DIRECTORY=uploads
# PUBLIC_BASE_URL=http://127.0.0.1:8081

# Private local cash evidence; defaults to LOCAL_IMAGE_DIRECTORY/cash-proofs in local mode.
# CASH_PROOF_DIRECTORY=uploads/cash-proofs

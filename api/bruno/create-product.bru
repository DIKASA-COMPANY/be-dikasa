meta {
  name: Create Product Without Image (Manager)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/dikasa/v1/products
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  name: Nasi Goreng
  category_id: {{categoryId}}
  product_type: food
  selling_price: 21000
  online_selling_price: 23000
  cost_price: 12000
  online_cost_price: 13000
  stock_status: available
  variations: [{"name":"Jumbo","selling_price":28000,"online_selling_price":30000,"cost_price":15000,"stock_status":"available","sort_order":10}]
  description: Nasi goreng spesial
  is_highlighted: false
  sort_order: 10
}

assert {
  res.status: eq 201
  res.body.data.id: isNotEmpty
}

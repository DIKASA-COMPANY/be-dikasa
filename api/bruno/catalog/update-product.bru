meta {
  name: Update Product (Manager)
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/dikasa/v1/products/{{productId}}
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:multipart-form {
  name: Nasi Goreng Spesial
  category_id: {{categoryId}}
  product_type: food
  selling_price: 25000
  online_selling_price: 27000
  stock_status: available
  variations: [{"name":"Jumbo","selling_price":30000,"stock_status":"available","sort_order":10}]
  description: Versi terbaru
  is_highlighted: true
  sort_order: 10
  is_active: true
  remove_image: false
}
assert {
  res.status: eq 200
}

meta {
  name: Adopt Uploaded Product Photo (Manager)
  type: http
  seq: 55
}
patch {
  url: {{baseUrl}}/dikasa/v1/products/{{productId}}
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:multipart-form {
  image_object_name: {{productImageObjectName}}
  remove_image: false
}

docs {
  First create an image upload intent, PUT the PNG/JPEG bytes directly to productImageUploadUrl, then send its exact productImageObjectName here. The DIKASA API never receives image bytes.
}
assert {
  res.status: eq 200
  res.body.data.image_url: isNotEmpty
}
tests {
  test("product image is a Supabase public URL", function () {
    expect(res.body.data.image_url).to.match(/^https:\/\/[^/]+\.supabase\.co\/storage\/v1\/object\/public\//);
  });
}

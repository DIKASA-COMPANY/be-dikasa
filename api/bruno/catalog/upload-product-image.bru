meta {
  name: Upload Product Photo (Manager)
  type: http
  seq: 55
}
patch {
  url: {{baseUrl}}/dikasa/v1/products/{{productId}}
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:multipart-form {
  image: @file({{productImagePath}})
  remove_image: false
}
assert {
  res.status: eq 200
  res.body.data.image_url: isNotEmpty
}
tests {
  test("product image is a Firebase download URL", function () {
    expect(res.body.data.image_url).to.match(/^https:\/\/firebasestorage\.googleapis\.com\/v0\/b\//);
  });
}

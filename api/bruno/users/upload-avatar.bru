meta {
  name: Adopt My Supabase Avatar
  type: http
  seq: 27
}

patch {
  url: {{baseUrl}}/dikasa/v1/users/me
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  avatar_object_name: {{avatarObjectName}}
  remove_avatar: false
}

assert {
  res.status: eq 200
  res.body.data.avatar_url: isNotEmpty
}

tests {
  test("avatar is a Supabase public URL", function () {
    expect(res.body.data.avatar_url).to.match(/^https:\/\/[^/]+\.supabase\.co\/storage\/v1\/object\/public\//);
  });
}

docs {
  First create an avatar upload intent, PUT the PNG/JPEG bytes directly to avatarUploadUrl, then send its exact avatarObjectName here. The backend revalidates the stored object before persisting its public URL.
}

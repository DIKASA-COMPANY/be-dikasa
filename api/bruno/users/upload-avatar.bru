meta {
  name: Upload My Supabase Avatar
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/dikasa/v1/users/me
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  avatar: @file({{profileImagePath}})
  remove_avatar: false
}

assert {
  res.status: eq 200
  res.body.data.avatar_url: isNotEmpty
}

tests {
  test("avatar is a Supabase public URL", function () {
    expect(res.body.data.avatar_url).to.match(/^https:\/\/[^/]+\.supabase\.co\/storage\/v1\/object\/public\//);
  });
}

docs {
  The backend validates and uploads the avatar to Supabase Storage. The response contains the public bucket URL; clients render that URL directly.
}

meta {
  name: Change My Password
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/dikasa/v1/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "current_password": "rahasia123",
    "new_password": "rahasia456",
    "new_password_confirmation": "rahasia456"
  }
}

assert {
  res.status: eq 204
}

docs {
  Changes the signed-in account only. Use a disposable test account. A lost response can mean success; do not retry automatically. Existing JWT sessions retain their expiry. Password changes require can_change_password=true; PINs are six digits. Concurrent stale changes return 409.
}

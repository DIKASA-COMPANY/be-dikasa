meta {
  name: Resend Registration OTP
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/dikasa/v1/register/otp/resend
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "budi@example.com"
  }
}

assert {
  res.status: eq 200
  res.body.data.resend_available_in: eq 60
}

meta {
  name: Movement audit detail
  type: http
  seq: 72
}
get {
  url: {{baseUrl}}/dikasa/v1/cash-sessions/{{cashSessionId}}/movements/{{cashMovementId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
assert {
  res.status: eq 200
}
docs {
  Use disposable test accounts for writes. Keep the exact request UUID/body/photo on a lost reply; never retarget another session or retry with a fresh UUID. Proof is private and optional.
}

meta {
  name: Create cash movement
  type: http
  seq: 72
}
post {
  url: {{baseUrl}}/dikasa/v1/cash-sessions/{{cashSessionId}}/movements
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:multipart-form {
  request_id: {{cashMovementRequestId}}
  kind: out
  name: Bank deposit
  amount: 10000
  reason: Deposit from till
  ~proof_object_name: {{cashProofObjectName}}
}
assert {
  res.status: eq 201
}
docs {
  Use disposable test accounts for writes. For optional proof, request a signed upload using the same request_id, PUT bytes directly to cashProofUploadUrl, then send cashProofObjectName. Keep the exact request UUID/body/object name on a lost reply.
}

tests {
  test("immutable identity returned", function () { expect(res.body.data.id).to.be.a("string"); expect(res.body.data.request_id).to.be.a("string"); expect(res.body.data).not.to.have.property("proof_url"); });
}

meta {
  name: Recover original cash request
  type: http
  seq: 73
}
get {
  url: {{baseUrl}}/dikasa/v1/cash-sessions/{{cashSessionId}}/movements/by-request/{{cashMovementRequestId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
assert {
  res.status: eq 200
}
docs {
  Use disposable test accounts for writes. Keep the exact request UUID/body/photo on a lost reply; never retarget another session or retry with a fresh UUID. Proof is private and optional.
}

tests {
  test("immutable identity returned", function () { expect(res.body.data.id).to.be.a("string"); expect(res.body.data.request_id).to.be.a("string"); expect(res.body.data).not.to.have.property("proof_url"); });
}

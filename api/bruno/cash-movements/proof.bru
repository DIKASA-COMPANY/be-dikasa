meta {
  name: Cash evidence Supabase URL
  type: http
  seq: 76
}
get {
  url: {{baseUrl}}/dikasa/v1/cash-sessions/{{cashSessionId}}/movements/{{cashMovementId}}/proof
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
assert {
  res.status: eq 200
  res.body.data.url: isNotEmpty
}
tests {
  test("proof uses the shared Supabase public URL", function () {
    expect(res.body.data.url).to.match(/^https:\/\/[^/]+\.supabase\.co\/storage\/v1\/object\/public\//);
  });
}
docs {
  Access to the stored URL requires an authenticated same-outlet lookup. The returned public bucket URL is rendered directly by the frontend and must be treated as sensitive.
}

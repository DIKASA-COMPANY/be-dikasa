meta {
  name: Cash evidence Firebase URL
  type: http
  seq: 75
}
get {
  url: {{baseUrl}}/dikasa/v1/cash-sessions/{{cashSessionId}}/movements/{{cashMovementId}}/proof
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
assert {
  res.status: eq 200
  res.body.data.url: isNotEmpty
}
tests {
  test("proof uses the shared Firebase download URL", function () {
    expect(res.body.data.url).to.match(/^https:\/\/firebasestorage\.googleapis\.com\/v0\/b\//);
  });
}
docs {
  Access to the stored URL requires an authenticated same-outlet lookup. The returned Firebase token URL is rendered directly by the frontend and must be treated as a bearer link.
}

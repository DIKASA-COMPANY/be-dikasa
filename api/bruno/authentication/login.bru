meta {
  name: Login
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/dikasa/v1/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "{{loginIdentifier}}",
    "password": "{{loginPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.token_type: eq Bearer
}

docs {
  PostgreSQL credentials are validated before Supabase Auth issues the access and refresh tokens. Existing bcrypt accounts are imported lazily on first login.
  Local JWT authentication is not supported.
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.data.access_token);
    bru.setEnvVar("refreshToken", res.body.data.refresh_token);
  }
}

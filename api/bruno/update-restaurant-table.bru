meta {
  name: Update Restaurant Table (Manager)
  type: http
  seq: 23
}

patch {
  url: {{baseUrl}}/dikasa/v1/restaurant-tables/{{restaurantTableId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {"name":"Meja Teras 1","capacity":4,"sort_order":10,"is_active":true}
}

assert {
  res.status: eq 200
  res.body.data.id: isNotEmpty
}

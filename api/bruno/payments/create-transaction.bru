meta {
  name: Pay Transaction With Wallet
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/dikasa/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "order_type_id": "{{orderTypeId}}",
    "payment_method": "wallet",
    "wallet_id": "{{walletId}}",
    "subtotal": 21000,
    "discount_amount": 0,
    "tax_percentage": 10,
    "tax_amount": 2100,
    "total_amount": 23100,
    "paid_amount": 23100,
    "change_amount": 0,
    "rounding_amount": 0,
    "tip_amount": 0,
    "items": [
      {
        "product_id": "{{productId}}",
        "product_name": "Nasi Goreng",
        "unit_price": 21000,
        "quantity": 1,
        "notes": "Tidak pedas",
        "line_total": 21000
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.data.transaction_number: isNotEmpty
  res.body.data.status: eq paid
  res.body.data.items: isArray
}


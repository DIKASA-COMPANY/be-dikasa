meta {
  name: Create Order Type (Manager)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/dikasa/v1/order-types
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  { "code": "drive_thru", "name": "Drive Thru", "sort_order": 70, "is_active": true }
}
assert {
  res.status: eq 201
}
